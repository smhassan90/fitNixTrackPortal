# API Configuration — backend base URL only (no trailing /api)
NEXT_PUBLIC_API_URL=https://fitnixtrackbackend.vercel.app

# Backend (fitnixtrackbackend): IANA timezone for attendance date bucketing and formatted times.
# GYM_TIMEZONE=Asia/Karachi

# Platform operator UI lives at /platform (same origin proxy as /api/*).
# Platform JWT is stored in sessionStorage, separate from gym admin localStorage token.

# Public URL of this Next app (used in uploaded logo URLs so the API can fetch them).
# Example: https://portal.example.com or http://localhost:3000
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel Blob (required for logo uploads on Vercel — filesystem is read-only in serverless).
# Create a Blob store in the Vercel project → Storage; Vercel adds BLOB_READ_WRITE_TOKEN automatically.
# BLOB_READ_WRITE_TOKEN=
