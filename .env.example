# API Configuration
# Set this to your cloud/production API URL
NEXT_PUBLIC_API_URL=https://fitnixtrackbackend.vercel.app

# Platform operator UI lives at /platform (same origin proxy as /api/*).
# Platform JWT is stored in sessionStorage, separate from gym admin localStorage token.

# Public URL of this Next app (used in uploaded logo URLs so the API can fetch them).
# Example: https://portal.example.com or http://localhost:3000
# NEXT_PUBLIC_APP_URL=http://localhost:3000
